# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=your-region  # e.g., us-central1

# RAG Corpus Configuration (Optional)
RAG_CORPUS_NAME=your-corpus-name  # Name of the RAG corpus for knowledge retrieval

#Google Cloud Cred
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/gcp-credentials.json"

# Database Configuration (PostgreSQL on GCP)
# Note: Using postgresql+psycopg for psycopg3 driver (Python 3.14+)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/blinky_db
# For GCP Cloud SQL: postgresql+psycopg://user:password@/dbname?host=/cloudsql/project:region:instance
SQL_ECHO=false

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# Twilio Voice Configuration (for phone calls)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Application
PORT=5003
DEFAULT_LANGUAGE=es
